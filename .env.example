# Copy to .env next to docker-compose.yml and edit before `docker compose up`.

# REQUIRED — sign-in tokens are signed with this. Generate one:
#   openssl rand -hex 32
JWT_SECRET=

# Postgres credentials (compose wires these into both db and api)
POSTGRES_DB=shopstock
POSTGRES_USER=shopstock
POSTGRES_PASSWORD=change-this-db-password

# Branding — the app name is configurable
APP_NAME=APEX Electrical Stock

# Your admin login, applied when you run `scripts/seed.py --minimal`
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=pick-a-real-password

# Outbound email for "send estimate to customer" — sends from an existing
# company mailbox over SMTP (Gmail/Office365/etc, not a third-party API).
# Leave blank to disable sending (fails with a clear error instead of a
# silent no-op). Port 587 + STARTTLS is standard for Gmail/Office365.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=APEX Electrical Group

# Public URL customers land on when they click an emailed estimate link
PUBLIC_BASE_URL=https://shop.apexelectricalgroupinc.com
