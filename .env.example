# Copy to .env next to docker-compose.yml and edit before `docker compose up`.

# REQUIRED — sign-in tokens are signed with this. Generate one:
#   openssl rand -hex 32
JWT_SECRET=

# Postgres credentials (compose wires these into both db and api)
POSTGRES_DB=shopstock
POSTGRES_USER=shopstock
POSTGRES_PASSWORD=change-this-db-password

# Branding — the app name is configurable
APP_NAME=APEX Electrical Stock

# Your admin login, applied when you run `scripts/seed.py --minimal`
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=pick-a-real-password
