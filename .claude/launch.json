{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "shopstock-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "web"],
      "port": 5173
    },
    {
      "name": "shopstock-api",
      "runtimeExecutable": "api/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--app-dir", "api", "--port", "8000"],
      "port": 8000
    }
  ]
}
